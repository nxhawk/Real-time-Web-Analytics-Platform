# Pulse Analytics — copy to .env and adjust. Never commit .env.
#
# Every variable below is read by backend/internal/config. Defaults shown are the ones the
# code applies when the variable is absent, so an empty .env is a valid development setup.
# Canonical values for the shared numbers live in PHASES.md section 2.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | staging | production | test
APP_ENV=development

# How long in-flight requests get to finish after SIGTERM.
SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Listen address of the ingest API (write path).
HTTP_ADDR=:8080

# Listen address of the analytics API (read path).
ANALYTICS_ADDR=:8081

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Maximum request body, in bytes. 1 MiB, per PLAN.md section 5.2.
HTTP_MAX_BODY_BYTES=1048576

# Comma-separated list of browser origins allowed to call the API.
# Empty means no cross-origin access; "*" allows everything (and disables credentials).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# json | text — use text for readable local output.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------

# Native protocol on port 9000. Never use the HTTP port for inserts.
# Inside docker compose the host is "clickhouse"; from the host machine it is "localhost".
CLICKHOUSE_DSN=clickhouse://pulse:pulse@localhost:9000/analytics

# Password used by docker compose when creating the ClickHouse user.
CLICKHOUSE_PASSWORD=pulse

CLICKHOUSE_MAX_OPEN_CONNS=16
CLICKHOUSE_MAX_IDLE_CONNS=8
CLICKHOUSE_CONN_MAX_LIFETIME=10m
CLICKHOUSE_DIAL_TIMEOUT=5s
CLICKHOUSE_QUERY_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Ingest / write path
# ---------------------------------------------------------------------------

# direct = the API writes to ClickHouse itself (Levels 1-3)
# kafka  = the API produces to Kafka and a consumer writes (Level 4+)
SINK=direct

# batch | single — "single" exists only so the Level 3 benchmark has a baseline.
INSERT_MODE=batch

# Rows per ClickHouse insert batch.
BATCH_SIZE=5000

# Maximum time a batch waits before being flushed, in milliseconds.
FLUSH_INTERVAL_MS=500

# Size of the in-memory queue between the HTTP handler and the batch writer.
BUFFER_SIZE=100000

# Number of batch-writer workers.
INGEST_WORKERS=4

# Where the write-ahead log is written when ClickHouse cannot be reached (Level 3).
WAL_DIR=./data/wal

# Maximum events accepted in one request. The API contract caps this at 500.
MAX_EVENTS_PER_REQUEST=500

# Rate limit per API key.
INGEST_RATE_LIMIT_PER_MIN=1000

# ---------------------------------------------------------------------------
# Kafka (Level 4 and later; leave empty until then)
# ---------------------------------------------------------------------------

KAFKA_BROKERS=
KAFKA_TOPIC_RAW=events.raw
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_GROUP_ID=clickhouse-sink
KAFKA_CONSUMER_BATCH_SIZE=10000

# ---------------------------------------------------------------------------
# Host port mapping for docker compose (change if a port is already taken)
# ---------------------------------------------------------------------------

INGEST_PORT=8080
ANALYTICS_PORT=8081
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
