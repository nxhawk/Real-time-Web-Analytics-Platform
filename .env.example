# Pulse Analytics — copy to .env and adjust. Never commit .env.
#
# Since Level 0.5 the defaults live in backend/config/<APP_ENV>.config.yml, not here. Those
# files are the source of truth and are committed; this file only supplies the values that
# differ per machine or that must not be in git.
#
#   backend/config/development.config.yml   loaded when APP_ENV=development (the default)
#   backend/config/staging.config.yml       APP_ENV=staging
#   backend/config/production.config.yml    APP_ENV=production
#   backend/config/test.config.yml          APP_ENV=test
#
# Anything written as ${VAR:-fallback} in those files can be overridden here. A real
# environment variable always wins over this file. An empty .env — or no .env at all — is a
# valid development setup.
#
# Canonical values for the shared numbers live in PHASES.md section 2.

# ---------------------------------------------------------------------------
# Which configuration file to load
# ---------------------------------------------------------------------------

# development | staging | production | test
APP_ENV=development

# ---------------------------------------------------------------------------
# The two things you are most likely to change locally
# ---------------------------------------------------------------------------

# Native protocol on port 9000. Never use the HTTP port for inserts.
# Inside docker compose the host is "clickhouse"; from the host machine it is "localhost".
# Required in staging and production — those files declare it with no fallback.
CLICKHOUSE_DSN=clickhouse://pulse:pulse@localhost:9000/analytics

# Password used by docker compose when creating the ClickHouse user.
CLICKHOUSE_PASSWORD=pulse

# Comma-separated list of browser origins allowed to call the API.
# Empty means no cross-origin access; "*" allows everything (and disables credentials).
# Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Host port mapping for docker compose (change if a port is already taken)
#
# These are read by docker-compose.yml, not by the Go code, so they have no counterpart in
# the YAML files.
# ---------------------------------------------------------------------------

INGEST_PORT=8080
ANALYTICS_PORT=8081
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ---------------------------------------------------------------------------
# Everything below is optional: uncomment only to override the YAML default.
# The value shown is what development.config.yml uses.
# ---------------------------------------------------------------------------

# --- Application ---
# SHUTDOWN_TIMEOUT=30s

# --- HTTP ---
# HTTP_ADDR=:8080
# ANALYTICS_ADDR=:8081
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_MAX_BODY_BYTES=1048576

# --- Logging ---
# LOG_LEVEL=info
# LOG_FORMAT=text

# --- ClickHouse pool ---
# CLICKHOUSE_MAX_OPEN_CONNS=16
# CLICKHOUSE_MAX_IDLE_CONNS=8
# CLICKHOUSE_CONN_MAX_LIFETIME=10m
# CLICKHOUSE_DIAL_TIMEOUT=5s
# CLICKHOUSE_QUERY_TIMEOUT=15s

# --- Ingest / write path ---
# SINK=direct
# INSERT_MODE=batch
# BATCH_SIZE=5000
# FLUSH_INTERVAL_MS=500
# BUFFER_SIZE=100000
# INGEST_WORKERS=4
# WAL_DIR=./data/wal
# MAX_EVENTS_PER_REQUEST=500
# INGEST_RATE_LIMIT_PER_MIN=1000

# --- Kafka (Level 4 and later; leave empty until then) ---
# KAFKA_BROKERS=
# KAFKA_TOPIC_RAW=events.raw
# KAFKA_TOPIC_DLQ=events.dlq
# KAFKA_GROUP_ID=clickhouse-sink
# KAFKA_CONSUMER_BATCH_SIZE=10000

# ---------------------------------------------------------------------------
# Where the loader looks for its files (rarely needed)
# ---------------------------------------------------------------------------

# Directory holding <APP_ENV>.config.yml. Unset, the loader walks up from the working
# directory looking for config/. The Docker image sets it to /config.
# CONFIG_DIR=

# Path to this file. Unset, the loader walks up from the working directory looking for .env.
# ENV_FILE=
